include "getARGV.idp"

real Da = getARGV("-Da", 1.0);
real Ds = getARGV("-Ds", 5000.0);
real B = getARGV("-B", 1.0);
real q = getARGV("-q", 0.5);
real Scrit = getARGV("-Scrit", 0.3);
real Tmax = getARGV("-Tmax", 50.0);

real Pm = 4.0;
real sStar = 0.01;
real epsilon = 100.0;
real Smax = 1.0;

real dt = 0.1;
real L = 200.0;
int N = 90;
mesh Th = square(N, N, [x * 2 * L - L, y * 2 * L - L], flags = 1);

fespace Vh(Th, P1);
Vh a, a0, vA, s, s0, vS;

macro Pfunc(S) (Pm* (1.0 - tanh((S - Scrit) * epsilon)) / 2.0) //
macro Qfunc(S) (q* S / (S + sStar)) //

s0 = Smax;
a0 = 0.5 * exp(-(x ^ 2 + y ^ 2) / 20.0);

problem TumorCells(a, vA) =
	int2d(Th)(a * vA / dt + Da * (dx(a) * dx(vA) + dy(a) * dy(vA)) + Pfunc(s0) * a * vA) 
	- int2d(Th)(a0 * vA / dt + B * a0 * (1.0 - a0) * vA) 
	+ on(1, 2, 3, 4, a = 0);

problem TumorSubstrate(s, vS) =
	int2d(Th)(s * vS / dt + Ds * (dx(s) * dx(vS) + dy(s) * dy(vS)))
	- int2d(Th)(s0 * vS / dt - Qfunc(s0) * a * vS) 
	+ on(1, 2, 3, 4, s = Smax);

int step = 0;

for (real t = 0; t <= Tmax; t += dt) {
	step++;

	TumorCells;
	a = max(0.0, min(1.0, a));

	TumorSubstrate;
	s = max(0.0, min(Smax, s));

	if (step % 5 == 0 || t == dt) {
		plot(a, fill = 1, value = 1, cmm = "Density a at t=" + t, nbiso = 20, wait = 0);
		cout << "FRAME_START" << endl;

		for (int i = 0; i < Th.nv; i++) {
			cout << Th(i).x << " " << Th(i).y << " " << a[](i) << endl;
		}
		cout << "FRAME_END" << endl;
	}

	/*if (step == 1 || abs(t - round(t / 10) * 10) < dt / 2 || t > (Tmax - dt / 2)) {
		plot(a, fill = 1, value = 1, cmm = "Density a at t=" + t, nbiso = 20, wait = 0);
	}*/
	a0 = a;
	s0 = s;
}