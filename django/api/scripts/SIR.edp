include "getARGV.idp"

real beta = getARGV("-beta", 0.4);
real gamma = getARGV("-gamma", 0.1);
real DS = getARGV("-DS", 2.0);
real DI = getARGV("-DI", 0.5);
real DR = getARGV("-DR", 2.0);
real Tmax = getARGV("-Tmax", 100.0);

int N = 80;
mesh Th = square(N, N, [100 * x, 100 * y], flags = 1);

fespace Vh(Th, P1);
Vh S, I, R;
Vh S0, I0, R0;
Vh vS, vI, vR;

real dt = 0.1;

I0 = 0.05 * exp(-((x - 50) ^ 2 + (y - 50) ^ 2) / 20);
S0 = 1.0 - I0;
R0 = 0.0;

problem eqS(S, vS) =
	int2d(Th)(S * vS + dt * DS * (dx(S) * dx(vS) + dy(S) * dy(vS)) + dt * beta * S * I0 * vS)
  - int2d(Th)(S0 * vS);

problem eqI(I, vI) =
	int2d(Th)(I * vI + dt * DI * (dx(I) * dx(vI) + dy(I) * dy(vI)) + dt * gamma * I * vI)
  - int2d(Th)(I0 * vI + dt * beta * S * I0 * vI);

problem eqR(R, vR) =
	int2d(Th)(R * vR + dt * DR * (dx(R) * dx(vR) + dy(R) * dy(vR)))
  - int2d(Th)(R0 * vR + dt * gamma * I * vR);

int step = 0;

for (real t = dt; t <= Tmax; t += dt) {
	step++;

	eqS;
	eqI;
	eqR;

	S = max(S, 0.0);
	I = max(I, 0.0);
	R = max(R, 0.0);
	

	if (step % 3 == 0 || t == dt) {
		cout << "FRAME_START" << endl;

		for (int i = 0; i < Th.nv; i ++) {
			cout << Th(i).x << " " << Th(i).y << " " << I[][i] << endl;
		}
		cout << "FRAME_END" << endl;
	}
	/*if (step % 100 == 0) {
		plot(I, fill = 1, value = 1, nbiso = 20, cmm = "Infected I(x,y) at t = " + t);
	}*/


	S0 = S;
	I0 = I;
	R0 = R;
}
